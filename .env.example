# Postgres (Neon via Vercel Marketplace gives you this)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Auth.js  ->  generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Public base URL encoded inside every QR code (no trailing slash). Use your FINAL domain before printing.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Random string. Salt for the daily-rotating visitor hash (raw IPs are never stored).
ANALYTICS_SALT=
# Timezone for daily / hourly charts
ANALYTICS_TZ=Asia/Bangkok

# Comma-separated Google emails allowed to open /admin/reports
ADMIN_EMAILS=you@gmail.com

# Google Web Risk API key (phishing / malware check). Optional, but strongly recommended.
WEB_RISK_API_KEY=

# Random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>" (set it in Vercel env).
CRON_SECRET=
# Scan retention in days (minimum 30)
RETENTION_DAYS=365
# Distinct reporters needed to auto-pause a QR for phishing/malware
REPORT_AUTOPAUSE_THRESHOLD=3
